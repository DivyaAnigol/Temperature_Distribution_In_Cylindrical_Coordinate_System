%% Dimensional Properties %%
R = 1; % Radius of the cylinder (m)
n = 10; % Number of nodes
dr = R/n; % Element size (m)
disp('dr = ');
disp(dr);
T_amb = 27 + 273; % Ambient or Wall temperature (K)

%% Matrix Formation %%
A = zeros(n, n);
b = zeros(n, 1);

% Zeroth node %
% -r(1/2)T1 + r(1/2)Ti = 0

A(1, 1) = -(dr);
A(1, 2) = (dr);
b(1, 1) = 0;

% Intermediate Nodes %
%  r(i-1/2)T(i-1) - (r(i+1/2) + r(i-1/2))Ti + r(i+1/2)T(i+1) = 0

for i = 2: (n-1)
    A(i, i-1) = (i-1)*dr;
    A(i, i) = -(((2*i) - 1)*dr);
    A(i, i+1) = i*dr;
    b(i, 1) = 0;
end

% Nth node %
A(n, n-1) = (n-1)*dr;
A(n,n) = -((2*R) + ((n-1)*dr));
b(n, 1) = -(2 * R * T_amb);

disp(A);
disp(b);

%% Calculate [A][T] = [b] %%

T = A\b;
disp(T);

%% Plotting graph %%
r = dr/2 : dr : R-dr/2;

plot(r,T,'-o','LineWidth',2);
grid on;
xlabel('Radius (m)');
ylabel('Temperature (K)');
title('Temperature Distribution in Cylinder');
